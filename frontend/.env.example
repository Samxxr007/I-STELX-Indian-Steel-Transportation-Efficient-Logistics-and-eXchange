# Backend API URL (for production deployments like Vercel frontend + Render/Railway backend)
# Example: https://istelx-api.onrender.com
VITE_API_URL=

# Backend WebSocket URL (optional, defaults to deriving from VITE_API_URL or current domain)
# Example: wss://istelx-api.onrender.com
VITE_WS_URL=

# CARTO Basemaps API Key (removes "API key required" watermark on Voyager tiles)
VITE_CARTO_API_KEY=cb1_421o_1_818db85b781f5985b191aea8
